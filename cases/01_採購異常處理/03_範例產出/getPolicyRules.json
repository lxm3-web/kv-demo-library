{"ok":true,"rules":[{"rule_id":"R001","condition":"price_delta_percent > 5","approval_level":"procurement_manager","description":"漲價超過5%，需採購經理核准"},{"rule_id":"R002","condition":"price_delta_percent > 10","approval_level":"procurement_director","description":"漲價超過10%，需採購主管核准"},{"rule_id":"R003","condition":"priority = high","approval_level":"production_director","description":"高優先級客戶訂單需通知生產主管"},{"rule_id":"R004","condition":"days_remaining < 3","approval_level":"urgent_meeting","description":"庫存低於3天需召開緊急會議"},{"rule_id":"R005","condition":"no_backup_vendor","approval_level":"supplier_negotiation","description":"無替代供應商需啟動供應商協商"},{"rule_id":"R006","condition":"available_qty < required_qty","approval_level":"sales_notification","description":"替代供應量不足需通知業務調整交期"},{"rule_id":"R007","condition":"delay_days > 7","approval_level":"senior_manager","description":"供應商延遲超過7天需升級主管處理"},{"rule_id":"R008","condition":"delay_days > 14","approval_level":"executive_review","description":"供應商延遲超過14天需高階主管審核"},{"rule_id":"R009","condition":"current_stock < safety_stock","approval_level":"inventory_controller","description":"低於安全庫存需通知庫存管理人"},{"rule_id":"R010","condition":"customer_priority = strategic","approval_level":"account_manager","description":"策略客戶受影響需通知客戶經理"}]}